<Window x:Class="DataViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataViewer"
        mc:Ignorable="d"
        Title="DataViewer 17.0"
        Width="1200"
        Height="780"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid 
             Name="g_main">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="160" />
                <RowDefinition Height="23" />
            </Grid.RowDefinitions>
            <Grid Height="Auto">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Name="menu1" Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid 
                    Grid.Column="0"
                    Name="menu_tab">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0486f0" Offset="0.0" />
                            <GradientStop Color="#65c0f0" Offset="1.0" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Button 
                        x:Name="b_info"
                        Content="&#xEA1F;"
                        HorizontalAlignment="Center"
                        Width="48"
                        Background="Transparent"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="18"
                        Height="48"
                        VerticalAlignment="Top"
                        Click="b_info_Click" 
                        Margin="0,0,0,0" />
                </Grid>
                <Grid
                    Grid.Column="1"
                    Name="tab_info">
                    <StackPanel>
                        <StackPanel.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0486f0" Offset="0.0" />
                                <GradientStop Color="#65c0f0" Offset="1.0" />
                            </LinearGradientBrush>
                        </StackPanel.Background>
                        <Label 
                            Content="Information"
                            Height="32"
                            VerticalAlignment="Top"
                            FontSize="18"
                            Foreground="#FFFFFF"/>
                        <Grid
                            Name="g_info"
                            Height="290">
                            <Label 
                                Content="x, y = "
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Foreground="#FFFFFF"
                                Margin="0,43,0,0" />
                            <TextBox
                                x:Name="t_ix"
                                Width="54"
                                Height="26"
                                Margin="68,43,0,0"
                                TextWrapping="Wrap"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                TextAlignment="Right"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                IsReadOnly="True" />
                            <TextBox
                                x:Name="t_iy"
                                Height="26"
                                Width="54"
                                Margin="127,43,0,0"
                                TextWrapping="Wrap"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                TextAlignment="Right"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                IsReadOnly="True" />
                            <TextBox
                                x:Name="t_re"
                                Height="26"
                                Margin="53,75,10,0"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                TextAlignment="Right"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                IsReadOnly="True" />
                            <TextBox
                                x:Name="t_im"
                                Height="26"
                                Margin="53,106,10,0"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                TextAlignment="Right"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                IsReadOnly="True" />
                            <TextBox x:Name="t_abs" 
                                Height="26"
                                Margin="53,137,10,0"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                TextAlignment="Right"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                IsReadOnly="True"/>
                            <TextBox x:Name="t_power" 
                                Height="26"
                                Margin="53,168,10,0"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                TextAlignment="Right"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                IsReadOnly="True"/>
                            <TextBox x:Name="t_phase" 
                                Height="26"
                                Margin="53,199,10,0"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                TextAlignment="Right"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                IsReadOnly="True"/>
                            <Label 
                                Name="lb_zmin"
                                Content="min = "
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Foreground="#FFFFFF"
                                Margin="0,223,0,0"
                                />
                            <Label 
                                Name="lb_zmax"
                                Content="max = "
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Foreground="#FFFFFF"
                                Margin="0,254,0,0" />
                            <TextBox
                                x:Name="t_zmin"
                                Height="26"
                                Margin="53,225,10,0"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                TextAlignment="Right"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                IsReadOnly="True" />
                            <TextBox
                                x:Name="t_zmax"
                                Height="26"
                                Margin="53,256,10,0"
                                TextWrapping="Wrap"
                                VerticalAlignment="Top"
                                TextAlignment="Right"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                IsReadOnly="True" />
                            <Label 
                                Content="Nx, Ny = "
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Foreground="#FFFFFF"
                                Margin="0,8,0,0"/>
                            <TextBox
                                x:Name="t_Nx"
                                Width="54"
                                Height="26"
                                Margin="68,10,0,0"
                                TextWrapping="Wrap"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                TextAlignment="Right"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                IsReadOnly="True" />
                            <TextBox x:Name="t_Ny" 
                                Height="26"
                                Width="54"
                                Margin="127,10,0,0"
                                TextWrapping="Wrap"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                TextAlignment="Right"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                IsReadOnly="True"/>

                            <CheckBox 
                                Name="cb_re" 
                                Content="re" 
                                HorizontalAlignment="Left" 
                                Margin="5,80,0,0" 
                                VerticalAlignment="Top" 
                                Foreground="#FFFFFF"
                                IsChecked="True"/>
                            <CheckBox 
                                Name="cb_im" 
                                Content="im" 
                                HorizontalAlignment="Left" 
                                Margin="5,111,0,0" 
                                VerticalAlignment="Top" 
                                Foreground="#FFFFFF"
                                IsChecked="True"/>
                            <CheckBox 
                                Name="cb_abs" 
                                Content="abs" 
                                HorizontalAlignment="Left" 
                                Margin="5,142,0,0" 
                                VerticalAlignment="Top" 
                                Foreground="#FFFFFF"/>
                            <CheckBox 
                                Name="cb_pow" 
                                Content="pow" 
                                HorizontalAlignment="Left" 
                                Margin="5,173,0,0" 
                                VerticalAlignment="Top"
                                Foreground="#FFFFFF"/>
                            <CheckBox 
                                Name="cb_pha" 
                                Content="pha" 
                                HorizontalAlignment="Left" 
                                Margin="5,204,0,0" 
                                VerticalAlignment="Top" 
                                Foreground="#FFFFFF"/>
                        </Grid>
                        <Grid Height="220">
                            <TextBox Name="t_note" 
                                TextWrapping="NoWrap"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                Text="" 
                                Margin="0,0,10,34" 
                                AcceptsReturn="True"
                                Background="Transparent"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"/>
                            <Button Name="b_clear" 
                                Content="Clear" 
                                Margin="106,191,10,0"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                Background="#2483ff"
                                Click="b_clear_Click_1" 
                                Height="25" 
                                VerticalAlignment="Top"/>
                            <Button Name="b_copy" 
                                Content="Copy" 
                                Margin="0,191,105,0"
                                Foreground="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                Background="#2483ff"
                                Click="b_copy_Click" 
                                Height="25" 
                                VerticalAlignment="Top"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer
                                Grid.Column="0"
                                Name="scrollViewer2"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalScrollBarVisibility="Visible"
                                VerticalScrollBarVisibility="Visible">
                                <Grid
                                    Name="PreviewGrid" >
                                    <Image
                                        Name="image1"
                                        Stretch="Fill"
                                        Margin="0,0,0,0"
                                        MouseMove="image1_MouseMove"
                                        MouseLeftButtonDown="image1_MouseLeftButtonDown"
                                        RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Grid>
                            </ScrollViewer>
                            <Grid Grid.Column="1">
                                <Button
                                    Name="Lwhite"
                                    Width="32"
                                    Height="32"
                                    Background="White"
                                    Margin="4,10,4,0"
                                    VerticalAlignment="Top"
                                    Click="Lwhite_Click"
                                    />
                                <Button
                                    Name="Lred"
                                    Width="32"
                                    Height="32"
                                    Background="LightPink"
                                    Margin="4,47,4,0"
                                    VerticalAlignment="Top"
                                    Click="Lred_Click"
                                    />
                                <Button
                                    Name="Lgreen"
                                    Width="32" Height="32"
                                    Background="LimeGreen"
                                    Margin="4,84,4,0"
                                    VerticalAlignment="Top"
                                    Click="Lgreen_Click"
                                    />
                                <Button
                                    Name="Lblue" 
                                    Width="32" 
                                    Height="32" 
                                    Background="LightSkyBlue"  
                                    Margin="4,121,4,0" 
                                    VerticalAlignment="Top"
                                    Click="Lblue_Click" 
                                    />
                                <Button 
                                    Name="Ldark" 
                                    Width="32" 
                                    Height="32" 
                                    Background="Gray" 
                                    Margin="4,158,4,0" 
                                    VerticalAlignment="Top"
                                    Click="Ldark_Click" 
                                    />
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBox 
                                Name="t_mag" 
                                Text="100" 
                                Height="24" 
                                Width="57" 
                                Margin="4,8,0,0" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Top" 
                                HorizontalContentAlignment="Right" 
                                />
                            <Label 
                                Name="label1" 
                                Content="%" 
                                Height="28" 
                                Width="28" 
                                Margin="59,7,0,0" 
                                HorizontalAlignment="Left" 
                                VerticalAlignment="Top" 
                                Foreground="Black" 
                                />
                            <Slider 
                                Name="slider1" 
                                Height="23" 
                                Margin="89,9,0,0" 
                                VerticalAlignment="Top" 
                                Minimum="10" 
                                Maximum="4000" 
                                Value="100" 
                                ValueChanged="slider1_ValueChanged" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <GridSplitter 
                Grid.Row="1"
                Name="gridSplitter1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#aaddff">
            </GridSplitter>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid 
                    Grid.Column="0">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0486f0" Offset="0.0" />
                            <GradientStop Color="#65c0f0" Offset="1.0" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <CheckBox
                        Name="cb_colmap"
                        Content="Color bar"
                        HorizontalAlignment="Left"
                        Foreground="#FFFFFF"
                        Margin="107,53,0,0"
                        VerticalAlignment="Top"/>
                    <Button 
                        x:Name="b_plotall"
                        Content="Plot all"
                        HorizontalAlignment="Left"
                        Height="30"
                        Width="88"
                        Margin="10,47,0,0"
                        Foreground="#FFFFFF"
                        BorderBrush="#FFFFFF"
                        Background="#2483ff"
                        FontSize="14"
                        VerticalContentAlignment="Center"
                        Click="b_plotall_Click" VerticalAlignment="Top" />
                    <Button 
                        x:Name="b_deleteall"
                        Content="Delete all"
                        Height="30"
                        Foreground="#FFFFFF"
                        BorderBrush="#FFFFFF"
                        Background="#2483ff"
                        FontSize="14"
                        VerticalContentAlignment="Center"
                        Click="b_deleteall_Click" 
                        Margin="131,83,0,0" 
                        VerticalAlignment="Top" HorizontalAlignment="Left" Width="109" />
                    <Button 
                        x:Name="b_delete"
                        Content="Delete"
                        Foreground="#FFFFFF"
                        BorderBrush="#FFFFFF"
                        Background="#2483ff"
                        FontSize="14"
                        VerticalContentAlignment="Center"
                        Click="b_delete_Click" 
                        Margin="10,83,0,0" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Width="109" />
                    <Button 
                        x:Name="b_applyall"
                        Content="Apply Settings to others"
                        HorizontalAlignment="Center"
                        Height="30"
                        Width="230"
                        Margin="0,10,0,0"
                        Foreground="#FFFFFF"
                        BorderBrush="#FFFFFF"
                        Background="#2483ff"
                        FontSize="14"
                        VerticalContentAlignment="Center"
                        Click="b_applyall_Click" VerticalAlignment="Top" />
                    <Button 
                        x:Name="b_phaseAnimation"
                        Content="Phase Animation"
                        HorizontalAlignment="Left"
                        Height="30"
                        Width="122"
                        Margin="10,118,0,0"
                        Foreground="#FFFFFF"
                        BorderBrush="#FFFFFF"
                        Background="#2483ff"
                        FontSize="14"
                        VerticalContentAlignment="Center"
                        Click="b_phaseAnimation_Click"  VerticalAlignment="Top" />
                </Grid>
                <Grid 
                    Grid.Column="1"
                    x:Name="listwindow"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch"
                    PreviewDragOver="listwindow_PreviewDragOver"
                    PreviewDrop="listwindow_PreviewDrop"
                    AllowDrop="True"
                    Background="White">
                    <DockPanel Margin="0,0,0,0">

                        <!-- ヘッダ -->
                        <Grid DockPanel.Dock="Top" Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="" FontWeight="Bold" Margin="0"/>
                            <TextBlock Grid.Column="1" Text="ファイル名" FontWeight="Bold" Margin="0"/>
                            <TextBlock Grid.Column="2" Text="フォーマット" FontWeight="Bold" Margin="0"/>
                            <TextBlock Grid.Column="3" Text="データ" FontWeight="Bold" Margin="0"/>
                            <TextBlock Grid.Column="4" Text="カラーマップ" FontWeight="Bold" Margin="0"/>
                            <TextBlock Grid.Column="5" Text="最小値" FontWeight="Bold" Margin="0"/>
                            <TextBlock Grid.Column="6" Text="最大値" FontWeight="Bold" Margin="0"/>
                            <TextBlock Grid.Column="7" Text="x座標" FontWeight="Bold" Margin="0"/>
                            <TextBlock Grid.Column="8" Text="y座標" FontWeight="Bold" Margin="0"/>
                            <TextBlock Grid.Column="9" Text="実部" FontWeight="Bold" Margin="0"/>
                            <TextBlock Grid.Column="10" Text="虚部" FontWeight="Bold" Margin="0"/>
                        </Grid>

                        <!-- 本体 -->
                        <ListView Name="listView1" ItemsSource="{Binding DV}" SelectionChanged="listView1_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="::" FontWeight="Bold" Margin="5"/>

                                        <TextBox Grid.Column="1"
                                            Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="2"/>

                                        <ComboBox Grid.Column="2"
                                             ItemsSource="{Binding FileFormatOptions}"
                                             SelectedItem="{Binding FileFormat}"
                                             Margin="2"/>

                                        <ComboBox Grid.Column="3"
                                             ItemsSource="{Binding PlotTypeOptions}"
                                             SelectedItem="{Binding PlotType}"
                                             Margin="2"/>

                                        <ComboBox Grid.Column="4"
                                             ItemsSource="{Binding ColorMapOptions}"
                                             SelectedItem="{Binding ColorMap}"
                                             Margin="2"/>

                                        <TextBox Grid.Column="5"
                                            Text="{Binding Min, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="2"/>

                                        <TextBox Grid.Column="6"
                                            Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="2"/>

                                        <ComboBox Grid.Column="7"
                                            ItemsSource="{Binding DataColumnOptions}"
                                            Text="{Binding ColX, UpdateSourceTrigger=PropertyChanged}"
                                            IsEditable="True"
                                            Margin="2"/>

                                        <ComboBox Grid.Column="8"
                                            ItemsSource="{Binding DataColumnOptions}"
                                            Text="{Binding ColY, UpdateSourceTrigger=PropertyChanged}"
                                            IsEditable="True"
                                            Margin="2"/>

                                        <ComboBox Grid.Column="9"
                                            ItemsSource="{Binding DataColumnOptions}"
                                            Text="{Binding ColRe, UpdateSourceTrigger=PropertyChanged}"
                                            IsEditable="True"
                                            Margin="2"/>

                                        <ComboBox Grid.Column="10"
                                            ItemsSource="{Binding DataImColumnOptions}"
                                            Text="{Binding ColIm, UpdateSourceTrigger=PropertyChanged}"
                                            IsEditable="True"
                                            Margin="2"/>

                                        <Button Grid.Column="11"
                                            Content="Preview"
                                            Command="{Binding Preview}"
                                            Margin="2"
                                            Padding="10,2"/>

                                        <Button Grid.Column="12"
                                            Content="Save"
                                            Command="{Binding Plot}"
                                            Margin="2"
                                            Padding="10,2"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Grid>
            </Grid>
            <StatusBar 
                Name="statusBar1" 
                Grid.Row="3" 
                Height="23" 
                Margin="0,0,0,0" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Bottom">
                <StatusBarItem>
                    <TextBlock x:Name="StatusText" Text="" />
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
